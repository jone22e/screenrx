{
  "name": "screenrx",
  "productName": "ScreenRx",
  "version": "0.1.0",
  "private": true,
  "description": "Gravador e editor de tela não destrutivo para desktop",
  "author": "Jone",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:native && electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "start": "electron-vite preview",
    "build:native": "node scripts/build-native.mjs",
    "build:voice": "node scripts/build-voice.mjs",
    "icon": "python3 scripts/make-icon.py build/icon.png",
    "icon:tray": "python3 scripts/make-tray-icon.py",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:native": "swift test --package-path native/macos/CaptureHelper",
    "test:voice": "swift test --package-path native/macos/VoiceHelper",
    "test:e2e": "node scripts/e2e-recording.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:native",
    "dist": "npm run build && npm run build:voice && electron-builder --mac --arm64 -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "dist:signed": "npm run build && npm run build:voice && electron-builder --mac --arm64 -c.mac.notarize=false",
    "release:mac": "npm run build && npm run build:voice && electron-builder --mac --arm64 --publish always",
    "dist:check": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
