{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/engine/**/*.ts",
    "src/server/**/*.ts",
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "vite.server.config.ts",
    "vitest.config.ts"
  ]
}
